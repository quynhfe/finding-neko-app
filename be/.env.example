# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/ExeProject?retryWrites=true&w=majority
MONGODB_DB_NAME=ExeProject

# JWT
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# SMTP for register OTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="ExeQuynh <your_email@gmail.com>"

# CORS
CORS_ORIGIN=http://localhost:3000
